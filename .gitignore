# deps
node_modules/

# run state (workflow runtime artifacts — never commit)
.pi/workflows/runs/
.pi/workflows/.state*.json

# workflow definitions ARE versioned (DESIGN.md §6); keep the rest of .pi/
# ignored (session data, decision chain, user decisions)
.pi/*
!.pi/workflows/
.pi/workflows/*
!.pi/workflows/*.json

# logs / tmp
*.log
*.tmp

# editor / OS
.DS_Store
.vscode/
.idea/
.pi-subagents/
